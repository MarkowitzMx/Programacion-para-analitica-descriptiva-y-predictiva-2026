      "outputs": [],
      "source": [
        "# ESCRIBE TU CÓDIGO AQUÍ\n",
        "# El primer 'for' recorre cada sublista (cada ciudad) dentro de lecturas_semana;\n",
        "# el segundo 'for' recorre cada temperatura dentro de esa sublista;\n",
        "# el 'if' filtra las mayores a 30. El resultado queda \"aplanado\" en una sola lista.\n",
        "temperaturas_altas = [t for dia_ciudad in lecturas_semana for t in dia_ciudad if t > 30]\n",
        "\n",
        "print(temperaturas_altas)"
      ]
