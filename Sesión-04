      "source": [
        "# ESCRIBE TU CÓDIGO AQUÍ\n",
        "# zip(ciudades, temperaturas) produce tuplas (ciudad, temperatura);\n",
        "# enumerate(..., start=1) agrega el número de fila empezando en 1\n",
